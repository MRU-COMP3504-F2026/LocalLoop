# copy this file to .env.local and fill in real values there
# .env.local is gitignored, don't commit secrets or real credentials
#
# values prefixed with NEXT_PUBLIC_ are exposed to the browser
# server-only secrets should not use that prefix

# copy these into .env.local before using login or the business dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key